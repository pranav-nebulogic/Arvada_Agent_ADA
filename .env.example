# .env.example
# Copy to .env and fill in your values.
# Never commit .env to git.

# ── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Postgres (your existing instance, managed via DBeaver) ───────────────
# The schema arvada_agent must exist — run init.sql in DBeaver first.
# search_path is set by the app at connection time, no need to add it to the URL.
POSTGRES_URL=postgresql://your_user:your_pass@localhost:5432/your_database

# ── Redis (local Docker) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Langfuse ──────────────────────────────────────────────────────────────
# Option A: Use cloud.langfuse.com (free tier — easier for local dev)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Option B: Use local Docker Langfuse (started by docker-compose)
# LANGFUSE_PUBLIC_KEY=pk-local-dev
# LANGFUSE_SECRET_KEY=sk-local-dev
# LANGFUSE_HOST=http://localhost:3000

# ── Agent Config ──────────────────────────────────────────────────────────
SEMANTIC_CACHE_THRESHOLD=0.92       # cosine similarity threshold for cache hits
SEMANTIC_CACHE_TTL_SECONDS=86400    # 24 hours
CONVERSATION_MEMORY_TTL_SECONDS=3600  # 1 hour
CONVERSATION_HISTORY_TURNS=6        # max turns to keep in context

# ── Model Selection ───────────────────────────────────────────────────────
INTENT_MODEL=gpt-4.1-nano-2025-04-14
GENERATION_MODEL=gpt-4.1-mini-2025-04-14
JUDGE_MODEL=gpt-4.1-nano-2025-04-14
EMBEDDING_MODEL=text-embedding-3-small

# ── Retrieval Config ──────────────────────────────────────────────────────
RETRIEVAL_TOP_K=10          # candidates from hybrid search before reranking
RERANK_TOP_K=5              # chunks passed to LLM after reranking

# ── Default Tenant ────────────────────────────────────────────────────────
DEFAULT_CITY_ID=arvada-co

# ── Agent Server ──────────────────────────────────────────────────────────
AGENT_HOST=0.0.0.0
AGENT_PORT=8001
AGENT_WORKERS=1             # 1 for local dev, 2-4 for production
LOG_LEVEL=info

# ── Internal Auth ─────────────────────────────────────────────────────────
# Secret shared with Spring Boot for service-to-service auth.
# Spring Boot sends this in X-Internal-Token header.
INTERNAL_SERVICE_TOKEN=local-dev-token-change-in-prod
